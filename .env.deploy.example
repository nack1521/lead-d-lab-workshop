# Deployment variables (names/classification only; fill values in the hosting
# platform dashboard, never commit real secrets). Local files remain separate.

# --- Railway API service (server-only secrets/settings) ---
DATABASE_URL=postgres://USER:PASSWORD@PRIVATE_HOST:5432/DBNAME?sslmode=require
# PORT is injected by Railway; do not set it manually unless required.
# Optional local-compatible overrides: API_PORT, API_HOST (default cloud bind is 0.0.0.0)
ALLOWED_ORIGINS=https://YOUR-PROJECT.pages.dev
GRANT_TTL_PARTICIPANT_SECONDS=14400
GRANT_TTL_FACILITATOR_SECONDS=28800
GRANT_TTL_HR_SECONDS=28800
WS_AUTH_TIMEOUT_MS=3000
HTTP_BODY_LIMIT_BYTES=16384
WS_FRAME_LIMIT_BYTES=4096
WS_SWEEP_INTERVAL_MS=30000
RECEIPT_READ_GRACE_SECONDS=900

# --- Cloudflare Pages web build (PUBLIC browser variables; URLs only) ---
VITE_API_BASE_URL=https://YOUR-API.up.railway.app
VITE_WS_URL=wss://YOUR-API.up.railway.app/ws
