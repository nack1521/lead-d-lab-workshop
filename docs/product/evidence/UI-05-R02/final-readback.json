        {
          "id": "66:270",
          "text": "ผู้ดำเนินกิจกรรม / ROOM-01"
        },
        {
          "id": "66:271",
          "text": "ยังไม่มีคำตอบที่บันทึกแล้ว"
        },
        {
          "id": "66:277",
          "text": "คำถาม 01 · กำลังเปิดรับคำตอบ"
        },
        {
          "id": "66:278",
          "text": "คุณมั่นใจในการให้ feedback ที่ช่วยให้ทีมพัฒนาได้เพียงใด?"
        },
        {
          "id": "66:279",
          "text": "ระดับ 1 = ยังไม่มั่นใจ · 5 = มั่นใจมาก"
        },
        {
          "id": "I66:272;47:85",
          "text": "ยังไม่มีคำตอบที่บันทึกแล้ว"
        },
        {
          "id": "I66:272;47:86",
          "text": "ตอนนี้มี 0 คำตอบที่บันทึกแล้ว จากผู้เข้าร่วม 30 คน ยังเปิดรับคำตอบอยู่"
        },
        {
          "id": "66:273",
          "text": "ตัวอย่างเพื่อออกแบบเท่านั้น · ไม่ใช่ผลจากฐานข้อมูลหรือ realtime"
        },
        {
          "id": "I66:275;47:53",
          "text": "ปิดรับคำถามนี้"
        }
      ]
    },
