{
  "name": "lead-d-c1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:ps": "docker compose ps",
    "migrate": "bun run apps/api/src/migrate.ts",
    "bootstrap": "bun run apps/api/src/bootstrap.ts",
    "api": "bun run apps/api/src/index.ts",
    "web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "test": "bun test tests",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "build:web:lan": "bun run --cwd apps/web build --mode lan",
    "lan:certs": "sh lan/generate-certs.sh",
    "lan:entry": "bun run lan/lan-entry.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "typescript": "5.9.3",
    "postgres": "3.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "vite": "6.4.5",
    "happy-dom": "21.0.4"
  }
}
