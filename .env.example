# Local tracer bullet configuration. Copy to .env and fill local-only values.
# .env is gitignored; never commit real credentials.

# --- server secrets ---
# Mode A: loopback-mapped PostgreSQL port.
DATABASE_URL=postgres://c1:c1_local_password_placeholder@127.0.0.1:5433/c1
# Mode B (container DNS): DATABASE_URL=postgres://c1:c1_local_password_placeholder@db:5432/c1

# --- server settings ---
API_HOST=127.0.0.1
API_PORT=3000
ALLOWED_ORIGINS=http://127.0.0.1:5173
GRANT_TTL_PARTICIPANT_SECONDS=14400
GRANT_TTL_FACILITATOR_SECONDS=28800
WS_AUTH_TIMEOUT_MS=3000
HTTP_BODY_LIMIT_BYTES=16384
WS_FRAME_LIMIT_BYTES=4096
RECEIPT_READ_GRACE_SECONDS=900

# --- local abuse budgets (per token / per instance) ---
RATE_PARTICIPANT_MAX=10
RATE_PARTICIPANT_WINDOW_MS=10000
RATE_FACILITATOR_MAX=30
RATE_FACILITATOR_WINDOW_MS=10000
RATE_GLOBAL_MAX=100
RATE_GLOBAL_WINDOW_MS=1000

# --- browser public (URLs only, no credentials) ---
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_WS_URL=ws://127.0.0.1:3000/ws
